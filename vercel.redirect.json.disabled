{
  "설명": "DNS 전파 완료 후 아래 내용을 vercel.json 의 redirects 값으로 넣으면 리다이렉트가 켜집니다.",
  "redirects": [
    {
      "source": "/((?!ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [{ "type": "host", "value": "playhanja.vercel.app" }],
      "destination": "https://hanja.chatgpts.kr/$1",
      "permanent": false
    }
  ]
}
